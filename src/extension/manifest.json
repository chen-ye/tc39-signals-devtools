{
  "manifest_version": 3,
  "name": "TC39 Signals DevTools",
  "version": "0.1.0",
  "description": "Inspect live TC39 Signals (signal-polyfill) reactivity graphs, causal re-run chains, and evaluation timelines in Chrome DevTools.",
  "minimum_chrome_version": "123",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["hook-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bridge-isolated.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
