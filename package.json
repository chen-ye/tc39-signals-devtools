{
  "name": "tc39-signals-devtools",
  "version": "0.1.0",
  "description": "Chrome DevTools extension and client/Vite bridge for inspecting a live TC39 Signals (signal-polyfill) reactivity graph",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/types/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./vite": {
      "types": "./dist/types/client/vite.d.ts",
      "import": "./dist/client/vite.js"
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run scripts/dev-demo.ts",
    "check": "bun check --no-script",
    "fmt": "bun fmt --no-script",
    "fmt:check": "bun fmt --no-script --check",
    "lint": "bunx oxlint --type-aware",
    "test": "bun test tests/unit",
    "test:e2e": "bunx playwright test -c tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "signal-polyfill": "^0.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.0",
    "@types/bun": "^1.3.12",
    "@types/chrome": "^0.1.40",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2008",
    "typescript": "^7.0.2",
    "vite": "^7.3.0"
  }
}
