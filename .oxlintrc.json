{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-unused-vars": "error"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "test-results/**",
    "playwright-report/**"
  ]
}
